{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ai-multi-chat",
  "version": "0.1.0",
  "identifier": "com.firefly.aimultichat",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:8800"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Chat · 多模型对话",
        "width": 1280,
        "height": 860,
        "center": true,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
